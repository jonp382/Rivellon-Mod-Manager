<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        
        xmlns:vm="using:ModManager.ViewModels"
        xmlns:models="using:ModManager.Models"
        xmlns:conv="using:ModManager.Converters"
        xmlns:controls="using:ModManager.Controls"

        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="ModManager.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="ModManager"
        
        Width="1050" Height = "750"
        MinWidth="1050" MinHeight="750"

        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource AppTextBrush}"
        >

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>
    
    <Window.Styles>
    
        <!-- Datagrid styling -->

        <!-- the cards provide the border, so the grids don't need their own -->
        <Style Selector="DataGrid">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
        </Style>

        <!-- column headers blend into the card instead of a dark bar -->
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style Selector="DataGridColumnHeadersPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="DataGridCell">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>

        <Style Selector="DataGrid">
            <Setter Property="RowHeight" Value="44"/>
        </Style>

        <!-- rounded thumbnail in the mod lists, shows a plain square while the image is missing -->
        <Style Selector="Border.Thumbnail">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}"/>
        </Style>

        <!-- panels (preview, enabled mods, disabled mods) -->

        <Style Selector="Border.Card">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <Style Selector="TextBlock.CardTitle">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="TextBlock.Muted">
            <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- small pill showing how many mods are in a list -->
        <Style Selector="Border.CountBadge">
            <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.CountBadge > TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}"/>
        </Style>

        <!-- action button styling: an icon with a short label underneath -->

        <Style Selector="Button.ActionBtn">
            <Setter Property="Width" Value="66"/>
            <Setter Property="Padding" Value="4,8"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="ToolTip.ShowDelay" Value="300"/>
        </Style>
        <Style Selector="Button.ActionBtn StackPanel">
            <Setter Property="Spacing" Value="4"/>
        </Style>
        <Style Selector="Button.ActionBtn Path">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Stroke" Value="{Binding $self.(TextElement.Foreground)}"/>
            <Setter Property="StrokeThickness" Value="1.8"/>
            <Setter Property="StrokeLineCap" Value="Round"/>
            <Setter Property="StrokeJoin" Value="Round"/>
        </Style>
        <Style Selector="Button.ActionBtn TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </Window.Styles>
    
    <!-- global grid -->
    <Grid RowDefinitions="Auto, Auto, *, 30">
        
        <!-- top menu row -->
        <Menu Grid.Row="0" Grid.ColumnSpan="2" FontSize="12" FontWeight="Bold" > 
            <MenuItem Header="File">

                <MenuItem
                    Header="Import Mod"
                    Command="{Binding ImportMod}"
                />

                <MenuItem 
                    Header="Extract PAK File"
                    Command="{Binding ExtractPakFileCommand}"
                />

                <MenuItem
                    Header="Download Norbyte's Script Extender (latest)"
                    Command="{Binding DownloadScriptExtenderCommand}"
                />
            </MenuItem>

            <MenuItem Header="Load Order">
               <MenuItem
                    Header="{Binding CurrentProfileText, StringFormat='{}Export Load Order to Game (Profile \'{0}\')'}"
                    Command="{Binding ExportLSXToProfileCommand}"
                />

                <MenuItem
                    Header="Export Load Order to File"
                    Command="{Binding ExportLoadOrderToFileCommand}"
                />

                <MenuItem
                    Header="Import Load Order from File"
                    Command="{Binding ImportLoadOrderFromFileCommand}"
                />
            </MenuItem>

            <MenuItem Header="Settings">
                <MenuItem
                    Header="Open Preferences"
                    Click="OnOpenSettingsClicked"
                    
                />
            </MenuItem>            

        </Menu>
        
        <!-- main area: preview card, enabled mods card, move buttons, disabled mods card -->
        <Grid 
            Name="MainGrid" 
            Grid.Row="2" 
            ColumnDefinitions="340, *, 76, *"
            Margin="10,4,10,10"
        >

            <!-- preview card on the left side -->
            <Border Grid.Column="0" Classes="Card" Margin="0,0,10,0">
                <Grid RowDefinitions="Auto, Auto, Auto, *">

                    <!-- preview image -->
                    <Border Grid.Row="0" CornerRadius="6" ClipToBounds="True" Background="{DynamicResource AppBackgroundBrush}" Height="300">
                        <Image
                            Source="{Binding PreviewMod.PreviewImage}"
                            Stretch="Uniform"
                            RenderOptions.BitmapInterpolationMode="HighQuality"
                        />
                    </Border>

                    <!-- mod name -->
                    <TextBlock
                        Grid.Row="1"
                        Margin="2,12,2,6"
                        Text="{Binding PreviewMod.Name}"
                        FontSize="16"
                        FontWeight="Bold"
                        TextWrapping="Wrap"
                    />

                    <!-- mod details -->
                    <StackPanel Grid.Row="2" Margin="2,0,2,10" Spacing="2">
                        <TextBlock Classes="Muted" Text="{Binding PreviewMod.Author, StringFormat='{}Author: {0}'}"/>
                        <TextBlock Classes="Muted" Text="{Binding PreviewMod.DisplayVersion, StringFormat='{}Version: {0}'}"/>
                        <TextBlock Classes="Muted" Text="{Binding PreviewMod.UUID, StringFormat='{}ID: {0}'}"/>
                        <TextBlock Classes="Muted" Text="{Binding PreviewMod.WorkshopID, StringFormat='{}Workshop ID: {0}'}"/>
                    </StackPanel>

                    <!-- mod workshop description -->
                    <Border Grid.Row="3" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                        <ScrollViewer>
                            <!-- renders the steam BBCode ([h1], [b], [list] etc.) instead of showing raw tags -->
                            <controls:BBCodeTextBlock
                                BBCode="{Binding PreviewMod.WorkshopDetails.Description}"
                                TextWrapping="Wrap"
                                Margin="2,0,12,0"
                            />
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

            <!-- enabled mods card -->
            <Border Grid.Column="1" Classes="Card">
                <Grid RowDefinitions="Auto, Auto, *">

                    <!-- header with the title and number of mods -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="4,0,0,8">
                        <TextBlock Classes="CardTitle" Text="Enabled Mods"/>
                        <Border Classes="CountBadge">
                            <TextBlock Text="{Binding EnabledMods.Count}"/>
                        </Border>
                    </StackPanel>

                    <TextBox
                        Grid.Row="1"
                        Margin="0,0,0,8"
                        PlaceholderText="Filter enabled mods..."
                        Name="EnabledSearchBox"
                        Text="{Binding EnabledSearchText, Mode=TwoWay}"
                    />

                        <DataGrid x:Name="EnabledGrid"
                            ItemsSource="{Binding EnabledModsView}"
                            Grid.Row="2"
                            IsReadOnly="True"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            ScrollViewer.HorizontalScrollBarVisibility="Auto"
                            
                            AutoGenerateColumns="False"
                            CanUserResizeColumns="True"
                            CanUserReorderColumns="True"
                            CanUserSortColumns="True"

                            DragDrop.AllowDrop="True"
                            PointerPressed="OnPointerPressed"

                            SelectionMode="Extended"
                            SelectionChanged="OnSelectionChanged"
                            >

                            <DataGrid.Styles>

                                <!-- style for all rows regardless of status -->
                                <Style Selector="DataGridRow" x:DataType="models:ModInfo">

                                   <!-- enable tooltip and use the converter to handle string? -> string -->
                                    <Setter 
                                        Property="ToolTip.Tip" 
                                        Value="{Binding InvalidReason, Converter={x:Static conv:StringToTooltipConverter.Instance}}"
                                            
                                    />

                                    <!-- styling for invalid mods -->
                                    <Setter 
                                        Property="Background" 
                                        Value="{Binding IsValid, Converter={x:Static conv:BoolToRedBrushConverter.Instance}}"
                                    />
                                </Style>
                            </DataGrid.Styles>

                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem 
                                        Header="Open Workshop Page in Browser"
                                        Command="{Binding OpenWorkshopPageCommand}"
                                    >
                                    </MenuItem>

                                    <MenuItem 
                                        Header="Open Workshop Page in Steam"
                                        Command="{Binding OpenWorkshopPageSteamCommand}"
                                    >
                                    </MenuItem>


                                </ContextMenu>
                            
                            </DataGrid.ContextMenu>

                            <!-- column declaration -->
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{ReflectionBinding LoadOrder}" />
                                <!-- small preview image, uses the images already downloaded from the workshop -->
                                <DataGridTemplateColumn Width="52" CanUserSort="False" CanUserResize="False" CanUserReorder="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="models:ModInfo">
                                            <Border Classes="Thumbnail">
                                                <Image Source="{Binding PreviewImage}" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Name" Binding="{ReflectionBinding Name}" />
                            </DataGrid.Columns>
                        </DataGrid>
                </Grid>
            </Border>

            <!-- buttons to move mods between the two lists -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="6">
                <Button Classes="ActionBtn" Command="{Binding EnableMod}" ToolTip.Tip="Enable the selected mods">
                    <StackPanel>
                        <Path Data="M 10 3 L 5 8 L 10 13"/>
                        <TextBlock Text="Enable"/>
                    </StackPanel>
                </Button>
                <Button Classes="ActionBtn" Command="{Binding EnableAllMods}" ToolTip.Tip="Enable all mods shown in the disabled list">
                    <StackPanel>
                        <Path Data="M 8 3 L 3 8 L 8 13 M 13 3 L 8 8 L 13 13"/>
                        <TextBlock Text="Enable all"/>
                    </StackPanel>
                </Button>
                <Button Classes="ActionBtn" Command="{Binding DisableMod}" ToolTip.Tip="Disable the selected mods">
                    <StackPanel>
                        <Path Data="M 6 3 L 11 8 L 6 13"/>
                        <TextBlock Text="Disable"/>
                    </StackPanel>
                </Button>
                <Button Classes="ActionBtn" Command="{Binding DisableAllMods}" ToolTip.Tip="Disable all mods shown in the enabled list">
                    <StackPanel>
                        <Path Data="M 3 3 L 8 8 L 3 13 M 8 3 L 13 8 L 8 13"/>
                        <TextBlock Text="Disable all"/>
                    </StackPanel>
                </Button>
                <Button Classes="ActionBtn accent" Command="{Binding SortMods}" Margin="0,12,0,0" ToolTip.Tip="Sort the enabled mods so every mod loads after the mods it depends on">
                    <StackPanel>
                        <Path Data="M 5 2 V 14 M 2 11 L 5 14 L 8 11 M 11 14 V 2 M 8 5 L 11 2 L 14 5"/>
                        <TextBlock Text="Sort"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- disabled mods card -->
            <Border Grid.Column="3" Classes="Card">
                <Grid RowDefinitions="Auto, Auto, *">

                    <!-- header with the title and number of mods -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="4,0,0,8">
                        <TextBlock Classes="CardTitle" Text="Disabled Mods"/>
                        <Border Classes="CountBadge">
                            <TextBlock Text="{Binding DisabledMods.Count}"/>
                        </Border>
                    </StackPanel>

                    <TextBox
                        Grid.Row="1"
                        Margin="0,0,0,8"
                        PlaceholderText="Filter disabled mods..."
                        Name="DisabledSearchBox"
                        Text="{Binding DisabledSearchText, Mode=TwoWay}"
                    />

                        <DataGrid x:Name="DisabledGrid"
                            ItemsSource="{Binding DisabledModsView}"
                            Grid.Row="2"
                            IsReadOnly="True"

                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            ScrollViewer.HorizontalScrollBarVisibility="Auto"
                            
                            AutoGenerateColumns="False"
                            CanUserResizeColumns="True"
                            CanUserReorderColumns="True"
                            CanUserSortColumns="True"

                            DragDrop.AllowDrop="True"
                            PointerPressed="OnPointerPressed"

                            SelectionMode="Extended"
                            SelectionChanged="OnSelectionChanged"
                            >

                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem 
                                        Header="Open Workshop Page in Browser"
                                        Command="{Binding OpenWorkshopPageCommand}"
                                    >
                                    </MenuItem>

                                    <MenuItem 
                                        Header="Open Workshop Page in Steam"
                                        Command="{Binding OpenWorkshopPageSteamCommand}"
                                    >
                                    </MenuItem>


                                </ContextMenu>
                            
                            </DataGrid.ContextMenu>

                            <!-- don't need any valid/invalid logic in disabled mods -->
                            <!-- column declaration -->
                            <DataGrid.Columns>
                                <!-- small preview image, uses the images already downloaded from the workshop -->
                                <DataGridTemplateColumn Width="52" CanUserSort="False" CanUserResize="False" CanUserReorder="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="models:ModInfo">
                                            <Border Classes="Thumbnail">
                                                <Image Source="{Binding PreviewImage}" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Name" Binding="{ReflectionBinding Name}" />
                                <DataGridTextColumn Header="Version" Binding="{ReflectionBinding DisplayVersion}" SortMemberPath="VersionNumber" />
                                <DataGridTextColumn Header="Author" Binding="{ReflectionBinding Author}" />
                            </DataGrid.Columns>
                        </DataGrid>
                </Grid>
            </Border>

            <!-- Drag-drop indicator to show where a mod will be placed. -->
            <Rectangle 
                Name="GridDropIndicator"
                Grid.ColumnSpan="4"
                Height="2"
                Fill="{DynamicResource SystemAccentColor}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                IsVisible="False"
                IsHitTestVisible="False"
            />
        </Grid>


        <!-- border for the status and profile display text at the bottom -->
        <Border
            Grid.Row="3"
            Background="{DynamicResource AppSurfaceBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            Padding="12,4"
            BorderThickness="0,1,0,0"
            
        >
            <DockPanel

            >
                <!-- status text -->
                <TextBlock
                    Text="{Binding StatusText, StringFormat='{}Status: {0}'}"
                    FontSize="11"
                    Foreground="{DynamicResource AppMutedTextBrush}"
                    HorizontalAlignment="Left"
                />

                <!-- current profile display -->
                <TextBlock
                    Text="{Binding CurrentProfileText, StringFormat='{}Selected Profile: {0}'}"
                    FontSize="11"
                    Foreground="{DynamicResource AppMutedTextBrush}"
                    HorizontalAlignment="Right"
                />

            </DockPanel>
        
    
        </Border>
    </Grid>
</Window>

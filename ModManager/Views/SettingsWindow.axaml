<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ModManager.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="300"
        x:Class="ModManager.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Settings" Width="1200" Height="300"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource AppTextBrush}">

        <Grid RowDefinitions="40, 40, 40, 50, 40, 40, 40" ColumnDefinitions="175, *, 75, 75" Margin="10">

        <!-- Divinity Data Folder -->
            <TextBlock
                Text="Divinity Data Folder"
                Grid.Row="0"
                Grid.Column="0"
                Margin="5"
                VerticalAlignment="Center"
            />

            <TextBox
                Name="DataFolderTextbox"
                Text="{Binding DataDirectory}"
                Grid.Row="0"
                Grid.Column="1"
                Margin="5"
                VerticalAlignment="Center"
                TextChanged="DataFolderTextbox_TextChanged"
                PlaceholderText="Where your save data and mods are stored"
            />

            <Button
                Name="DataFolderButton"
                Content="Select"
                Grid.Row="0"
                Grid.Column="2"
                Margin="5"
                VerticalAlignment="Center"
                Command="{Binding SelectDataDirectory}"
            />

            <Button
                Name="AutoDataFolderButton"
                Content="Auto"
                Grid.Row="0"
                Grid.Column="3"
                Margin="5"
                VerticalAlignment="Center"
                Command="{Binding AutoSelectDataDirectory}"
            />

        <!-- Divinity WORKSHOP folder -->
            <TextBlock
                Text="Workshop Folder"
                Grid.Row="1"
                Margin="5"
                VerticalAlignment="Center"
            />

            <TextBox
                Text="{Binding WorkshopDirectory}"
                Grid.Row="1"
                Grid.Column="1"
                Margin="5"
                VerticalAlignment="Center"
                PlaceholderText="Where the workshop mods are stored, in your steam directory"
            />

            <Button
                Name="WorkshopFolderButton"
                Content="Select"
                Grid.Row="1"
                Grid.Column="2"
                Margin="5"
                VerticalAlignment="Center"
                Command="{Binding SelectWorkshopDirectoryCommand}"
            />

            <Button
                Name="AutoWorkshopFolderButton"
                Content="Auto"
                Grid.Row="1"
                Grid.Column="3"
                Margin="5"
                VerticalAlignment="Center"
                Command="{Binding AutoSelectWorkshopDirectory}"
            />

        <!-- Current Profile Dropdown Selection -->
            <TextBlock
                Text="Current Profile"
                Grid.Row="3"
                Grid.Column="0"
                Margin="5"
                VerticalAlignment="Center"
            />

             <TextBlock
                Text="Current Profile"
                Grid.Row="3"
                Grid.Column="0"
                Margin="5"
                VerticalAlignment="Center"
            />

            <ComboBox
                Name="ProfileComboBox"
                ItemsSource="{Binding AllProfiles}"
                SelectedItem="{Binding CurrentProfile}"
                Grid.Row="3"
                Grid.Column="1"
                Margin="5"
                VerticalAlignment="Center"
            />

        <!-- Divinity Game Directory -->

            <TextBlock
                Text="Game Folder"
                Grid.Row="2"
                Margin="5"
                VerticalAlignment="Center"
            />

            <TextBox
                Text="{Binding GameDirectory}"
                Grid.Row="2"
                Grid.Column="1"
                Margin="5"
                VerticalAlignment="Center"
                PlaceholderText="Where the game is installed on Steam"
            />

            <Button
                Name="GameFolderButton"
                Content="Select"
                Grid.Row="2"
                Grid.Column="2"
                Margin="5"
                VerticalAlignment="Center"
                Command="{Binding SelectGameDirectoryCommand}"
            />

            <Button
                Name="AutoGameFolderButton"
                Content="Auto"
                Grid.Row="2"
                Grid.Column="3"
                Margin="5"
                VerticalAlignment="Center"
                Command="{Binding AutoSelectGameDirectory}"
            />

        <!-- Dark Mode Toggle -->
            <TextBlock
                Text="Enable Dark Theme"
                Grid.Row="4"
                Grid.Column="0"
                VerticalAlignment="Center"
                Margin="5"
            />

            <CheckBox
                Grid.Row="4"
                Grid.Column="1"
                Margin="5"
                VerticalAlignment="Center"
                HorizontalAlignment="Left"
                IsChecked="{Binding EnableDarkTheme}"
            />

        <!-- Apply/Cancel buttons -->
            <Button
                Content="Apply"
                Name="ApplyButton"
                Click="ApplyButton_Click"
                Grid.Row="5"
                Grid.Column="0"
                VerticalAlignment="Bottom"
            />

            <Button
                Content="Cancel"
                Name="CancelButton"
                Click="CancelButton_Click"
                Grid.Row="5"
                Grid.Column="1"
                VerticalAlignment="Bottom"
            />
        
        <!-- Config disclaimer -->
            <TextBlock
                Text="Config is saved in the 'config' sub-folder, next to the program executable"
                Grid.Row="6"
                Grid.ColumnSpan="4"
                Grid.Column="0"
                TextWrapping="NoWrap"
                Margin="0, 10"
                VerticalAlignment="Center"
            />
            
        </Grid>


</Window>
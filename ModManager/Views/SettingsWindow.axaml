<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ModManager.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="300"
        x:Class="ModManager.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Settings" Width="500" Height="300">

        <Grid RowDefinitions="30, 30" ColumnDefinitions="175, *" Margin="10">
            <TextBlock
                Text="Divinity Data Folder"
                Grid.Row="0"
                Grid.Column="0"
            />

            <TextBox
                Text="{Binding ProfileDirectory}"
                Grid.Row="0"
                Grid.Column="1"
            />

            <TextBlock
                Text="Divinity Current Profile"
                Grid.Row="1"
                Grid.Column="0"
            />

            <TextBox
                Text="{Binding ProfileDirectory}"
                Grid.Row="1"
                Grid.Column="1"
            />
        </Grid>


</Window>
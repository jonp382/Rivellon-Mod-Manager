<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ModManager.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="600"
        x:Class="ModManager.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Icon="/Assets/app-icon.ico"
        Title="Settings - Rivellon Mod Manager"
        Width="820" MinWidth="680"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource AppTextBrush}">

    <Window.Styles>
        <!-- name of a setting, with a short muted explanation underneath -->
        <Style Selector="TextBlock.FieldLabel">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.FieldHelp">
            <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,2,0,6"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="Border.Card">
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style Selector="Button.Small">
            <Setter Property="MinWidth" Value="70"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Styles>

    <DockPanel Margin="16">

        <!-- header -->
        <StackPanel DockPanel.Dock="Top" Margin="2,0,0,14">
            <TextBlock Text="Settings" FontSize="20" FontWeight="Bold"/>
            <TextBlock Classes="Muted" Text="Tell the mod manager where Divinity: Original Sin 2 keeps its files." Margin="0,2,0,0"/>
        </StackPanel>

        <!-- footer: where the config lives, and cancel/apply -->
        <DockPanel DockPanel.Dock="Bottom" Margin="2,16,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                <Button
                    Name="CancelButton"
                    Content="Cancel"
                    Click="CancelButton_Click"
                    Classes="Toolbar"
                    MinWidth="90"
                    HorizontalContentAlignment="Center"
                />
                <Button
                    Name="ApplyButton"
                    Content="Apply"
                    Click="ApplyButton_Click"
                    Classes="Toolbar accent"
                    MinWidth="90"
                    HorizontalContentAlignment="Center"
                    FontWeight="SemiBold"
                />
            </StackPanel>
            <TextBlock
                Classes="Muted"
                FontSize="11"
                VerticalAlignment="Center"
                Text="Settings are saved in the 'config' folder next to the program."
            />
        </DockPanel>

        <StackPanel Spacing="12">

            <!-- folders card -->
            <Border Classes="Card">
                <StackPanel Spacing="16">

                    <DockPanel>
                        <Button
                            DockPanel.Dock="Right"
                            Classes="Small"
                            Command="{Binding AutoDetermineFoldersCommand}"
                            ToolTip.Tip="Pick your steamapps folder once, and all three folders below are filled in for you"
                        >
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Classes="Icon" Data="M 8 2 V 4 M 8 12 V 14 M 2 8 H 4 M 12 8 H 14 M 8 5.5 A 2.5 2.5 0 1 1 7.99 5.5"/>
                                <TextBlock Text="Detect all folders"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Classes="CardTitle" Text="Folders"/>
                    </DockPanel>

                    <!-- Divinity Data Folder -->
                    <StackPanel>
                        <TextBlock Classes="FieldLabel" Text="Data folder"/>
                        <TextBlock Classes="FieldHelp" Text="Where the game keeps your mods and player profiles. Usually Documents › Larian Studios › Divinity Original Sin 2 Definitive Edition."/>
                        <Grid ColumnDefinitions="*, Auto, Auto">
                            <TextBox
                                Grid.Column="0"
                                Name="DataFolderTextbox"
                                Text="{Binding DataDirectory}"
                                TextChanged="DataFolderTextbox_TextChanged"
                                PlaceholderText="Where your save data and mods are stored"
                            />
                            <Button Grid.Column="1" Classes="Small" Margin="8,0,0,0" Content="Browse" Command="{Binding SelectDataDirectory}"/>
                            <Button Grid.Column="2" Classes="Small" Margin="6,0,0,0" Content="Auto" Command="{Binding AutoSelectDataDirectory}" ToolTip.Tip="Detect this folder automatically"/>
                        </Grid>
                    </StackPanel>

                    <!-- Divinity WORKSHOP folder -->
                    <StackPanel>
                        <TextBlock Classes="FieldLabel" Text="Workshop folder"/>
                        <TextBlock Classes="FieldHelp" Text="Where Steam downloads workshop mods. Usually steamapps › workshop › content › 435150."/>
                        <Grid ColumnDefinitions="*, Auto, Auto">
                            <TextBox
                                Grid.Column="0"
                                Text="{Binding WorkshopDirectory}"
                                PlaceholderText="Where the workshop mods are stored, in your steam directory"
                            />
                            <Button Grid.Column="1" Classes="Small" Margin="8,0,0,0" Content="Browse" Command="{Binding SelectWorkshopDirectoryCommand}"/>
                            <Button Grid.Column="2" Classes="Small" Margin="6,0,0,0" Content="Auto" Command="{Binding AutoSelectWorkshopDirectory}" ToolTip.Tip="Detect this folder automatically"/>
                        </Grid>
                    </StackPanel>

                    <!-- Divinity Game Directory -->
                    <StackPanel>
                        <TextBlock Classes="FieldLabel" Text="Game folder"/>
                        <TextBlock Classes="FieldHelp" Text="Where the game is installed. Usually steamapps › common › Divinity Original Sin 2. Needed for installing the script extender."/>
                        <Grid ColumnDefinitions="*, Auto, Auto">
                            <TextBox
                                Grid.Column="0"
                                Text="{Binding GameDirectory}"
                                PlaceholderText="Where the game is installed on Steam"
                            />
                            <Button Grid.Column="1" Classes="Small" Margin="8,0,0,0" Content="Browse" Command="{Binding SelectGameDirectoryCommand}"/>
                            <Button Grid.Column="2" Classes="Small" Margin="6,0,0,0" Content="Auto" Command="{Binding AutoSelectGameDirectory}" ToolTip.Tip="Detect this folder automatically"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- profile and appearance card -->
            <Border Classes="Card">
                <StackPanel Spacing="16">
                    <TextBlock Classes="CardTitle" Text="Profile &amp; Appearance"/>

                    <!-- Current Profile Dropdown Selection -->
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Classes="FieldLabel" Text="Profile"/>
                            <TextBlock Classes="FieldHelp" Margin="0,2,0,0" Text="The DOS2 player profile whose load order is shown and saved. Profiles are read from the data folder."/>
                        </StackPanel>
                        <ComboBox
                            Grid.Column="1"
                            Name="ProfileComboBox"
                            ItemsSource="{Binding AllProfiles}"
                            SelectedItem="{Binding CurrentProfile}"
                            MinWidth="200"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                        />
                    </Grid>

                    <!-- Dark Mode Toggle -->
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Classes="FieldLabel" Text="Dark theme"/>
                            <TextBlock Classes="FieldHelp" Margin="0,2,0,0" Text="Use the dark colour scheme. Takes effect when you press Apply."/>
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="1"
                            IsChecked="{Binding EnableDarkTheme}"
                            OnContent="On"
                            OffContent="Off"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                        />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </DockPanel>
</Window>

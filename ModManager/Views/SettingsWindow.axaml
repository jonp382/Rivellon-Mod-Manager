<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ModManager.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="300"
        x:Class="ModManager.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Settings" Width="800" Height="300">

        <Grid RowDefinitions="40, 40, 50" ColumnDefinitions="175, *, 75" Margin="10">

            <TextBlock
                Text="Divinity Data Folder"
                Grid.Row="0"
                Grid.Column="0"
                Margin="5"
                VerticalAlignment="Center"
            />

            <TextBox
                Name="DataFolderTextbox"
                Text="{Binding DataDirectory}"
                Grid.Row="0"
                Grid.Column="1"
                Margin="5"
                VerticalAlignment="Center"
                TextChanged="DataFolderTextbox_TextChanged"
            />

            <Button
                Name="DataFolderButton"
                Content="Select"
                Grid.Row="0"
                Grid.Column="2"
                Margin="5"
                VerticalAlignment="Center"
                Command="{Binding SelectDataDirectory}"
            />

            <TextBlock
                Text="Current Profile"
                Grid.Row="1"
                Grid.Column="0"
                Margin="5"
                VerticalAlignment="Center"
            />

            <ComboBox
                Name="ProfileComboBox"
                ItemsSource="{Binding AllProfiles}"
                SelectedItem="{Binding CurrentProfile}"
                Grid.Row="1"
                Grid.Column="1"
                Margin="5"
                VerticalAlignment="Center"
            />

            <Button
                Content="Apply"
                Name="ApplyButton"
                Click="ApplyButton_Click"
                Grid.Row="2"
                Grid.Column="0"
                VerticalAlignment="Bottom"
            />

            <Button
                Content="Cancel"
                Name="CancelButton"
                Click="CancelButton_Click"
                Grid.Row="2"
                Grid.Column="1"
                VerticalAlignment="Bottom"
            />

            
        </Grid>


</Window>
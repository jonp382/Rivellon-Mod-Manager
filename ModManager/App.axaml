<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ModManager.App"
             xmlns:local="using:ModManager"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                
                <!-- Background is the window, Surface is the cards drawn on top of it -->
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#161619" />
                    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#212126" />
                    <SolidColorBrush x:Key="AppBorderBrush" Color="#2E2E35" />
                    <SolidColorBrush x:Key="AppTextBrush" Color="#E6E6E9" />
                    <SolidColorBrush x:Key="AppMutedTextBrush" Color="#9A9AA6" />
                    <!-- dark text on the amber accent buttons, white is hard to read on it -->
                    <SolidColorBrush x:Key="AccentButtonForeground" Color="#1F1606" />
                    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#1F1606" />
                    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#3A2A0C" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#EEF0F3" />
                    <SolidColorBrush x:Key="AppSurfaceBrush" Color="White" />
                    <SolidColorBrush x:Key="AppBorderBrush" Color="#DDE1E7" />
                    <SolidColorBrush x:Key="AppTextBrush" Color="#102A43" />
                    <SolidColorBrush x:Key="AppMutedTextBrush" Color="#5F6B7A" />
                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <!-- amber/gold accent to match DOS2's own UI, instead of the operating system's accent colour -->
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Dark" Accent="#FFD9A441" />
                <ColorPaletteResources x:Key="Light" Accent="#FFB0761C" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
    </Application.Styles>
</Application>